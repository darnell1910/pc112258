# Environment: Example
# Description: Template of the environment variables required by the Open Breweries DB application.
# Usage: copy this file as .env.development and .env.production, then fill in your own keys.

# VITE_BREWERIES_API_URL is the base URL of the Open Brewery DB API.
VITE_BREWERIES_API_URL="https://api.openbrewerydb.org/v1"
# VITE_BREWERIES_ENDPOINT_PATH is the path of the breweries endpoint.
VITE_BREWERIES_ENDPOINT_PATH="/breweries"
# VITE_LOGO_API_URL is the base URL of the Logo.dev Logo API.
VITE_LOGO_API_URL="https://img.logo.dev"
# VITE_LOGO_PUBLISHABLE_API_KEY is the publishable API key of the Logo.dev Logo API.
VITE_LOGO_PUBLISHABLE_API_KEY="your_logo_dev_publishable_api_key"
# VITE_APPLICATION_LOGO_DOMAIN is the domain used to resolve the application logo.
VITE_APPLICATION_LOGO_DOMAIN="openbrewerydb.org"
# VITE_PRIME_UI_LICENSE_KEY is the license key of the Prime UI component library.
VITE_PRIME_UI_LICENSE_KEY="your_prime_ui_license_key"
